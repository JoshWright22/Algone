{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "REMOTE_RULES": "true" }
    },
    "production": {
      "autoIncrement": false,
      "env": { "REMOTE_RULES": "true" },
      "ios": { "env": { "REMOTE_RULES": "false" } }
    }
  },
  "submit": { "production": {} }
}
