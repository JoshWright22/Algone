<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.joshwright22.algone.a11y" >

    <uses-sdk android:minSdkVersion="24" />

    <application>
        <service
            android:name="io.github.joshwright22.algone.a11y.AlgoneAccessibilityService"
            android:exported="false"
            android:label="@string/algone_a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" >
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/algone_accessibility_service" />
        </service>
    </application>

</manifest>