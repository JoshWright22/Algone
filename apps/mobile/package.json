{
  "name": "algone-browser",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "page": "node scripts/build-page-script.mjs",
    "icons": "node scripts/make-icons.mjs",
    "postinstall": "node scripts/build-page-script.mjs",
    "prestart": "npm run page",
    "start": "expo start",
    "android": "npm run page && expo start --android",
    "ios": "npm run page && expo start --ios",
    "pretypecheck": "npm run page",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run page",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "export:android": "npm run page && expo export --platform android",
    "export:ios": "npm run page && expo export --platform ios",
    "ci": "npm run typecheck && npm test && npm run export:android && npm run export:ios"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/react": "~19.3.0",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-share-intent": "^9.0.0",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "~6.0.3"
  }
}
