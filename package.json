{
  "name": "algone",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Algone: Algorithm Control. Replace algorithmic feeds with something you control.",
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["packages/*", "apps/extension", "apps/website"],
  "scripts": {
    "build": "npm run build --workspace apps/extension -- --target all",
    "build:rules": "node packages/rules/scripts/publish-rules.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test --project=e2e",
    "test:firefox": "node tests/firefox/smoke.mjs",
    "test:live": "node tests/live/run.mjs",
    "check:logged-in": "node tests/live/run.mjs --logged-in",
    "snapshot:scan": "node tests/live/scan-snapshots.mjs",
    "assets": "node scripts/make-assets.mjs",
    "website": "npm run build --workspace apps/website"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "geckodriver": "8.0.0",
    "selenium-webdriver": "4.52.0",
    "sharp": "0.35.5",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "web-ext": "10.8.0"
  }
}
